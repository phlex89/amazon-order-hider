{
  "name": "amazon-order-hider",
  "version": "1.0.0",
  "description": "Chrome extension to hide Amazon orders from order history",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-extension.js",
    "build:with-check": "vue-tsc && vite build && node scripts/build-extension.js",
    "build:extension": "npm run build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.258",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.27"
  }
} 